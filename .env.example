# Razorpay API keys — Dashboard > Account & Settings > API Keys
# Use test keys first. Never commit real secrets.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Optional: separate secret for unlock tokens (defaults to RAZORPAY_KEY_SECRET)
# UNLOCK_TOKEN_SECRET=

# Optional: amount in smallest currency unit (default 500 = USD 5.00) and currency
# RAZORPAY_AMOUNT=500
# RAZORPAY_CURRENCY=USD

# Optional: absolute API origin for static/itch builds (empty = same-origin)
# VITE_API_BASE=https://stickwoman-hook.vercel.app
